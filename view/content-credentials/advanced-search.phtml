<?php
/*
 * SPEC-003: the browse filter's field in the admin media advanced search.
 * Only the module's own states and headlines are written here; the query's
 * value is compared, never echoed.
 */
use ContentCredentials\Display\FilterValue;
use ContentCredentials\Display\Presentation;

$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$current = FilterValue::parse(is_array($query ?? null) ? ($query[FilterValue::PARAMETER] ?? null) : null);
?>
<div class="field">
    <div class="field-meta">
        <label for="content-credentials-state"><?php echo $escape($translate('Content Credentials')); ?></label>
    </div>
    <div class="inputs">
        <select name="<?php echo FilterValue::PARAMETER; ?>" id="content-credentials-state">
            <option value=""><?php echo $escape($translate('Any')); ?></option>
            <?php foreach (Presentation::HEADLINES as $state => $headline): ?>
            <option value="<?php echo $escape($state); ?>"<?php echo $current === $state ? ' selected' : ''; ?>><?php echo $escape($translate($headline)); ?></option>
            <?php endforeach; ?>
        </select>
    </div>
</div>
