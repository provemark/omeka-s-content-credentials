{
    "name": "mauricevanloon/omeka-s-content-credentials",
    "description": "Omeka S module that verifies the Content Credentials (C2PA) of uploaded media and shows the result in the admin interface.",
    "type": "omeka-s-module",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Maurice van Loon"
        }
    ],
    "require": {
        "php": "^8.3",
        "provemark/c2pa-verifier": "^0.11"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^4.7",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "ContentCredentials\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ContentCredentials\\Tests\\": "tests/"
        }
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "ContentCredentials\\Vendor\\",
            "packages": [
                "provemark/c2pa-verifier"
            ],
            "update_call_sites": [
                "src"
            ],
            "delete_vendor_packages": true
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "spec-check": "@php bin/spec-check.php",
        "format": "pint",
        "lint": "pint --test",
        "analyse": [
            "sh tools/fetch-omeka.sh",
            "phpstan analyse --no-progress --memory-limit=1G"
        ],
        "deptrac": "deptrac analyse --no-progress",
        "test": "pest --testsuite=Unit",
        "check": [
            "@spec-check",
            "@lint",
            "@analyse",
            "@deptrac",
            "@test",
            "@test:integration",
            "@test:release"
        ],
        "test:integration": [
            "sh tools/env/up.sh",
            "pest --testsuite=Integration"
        ],
        "test:release": "sh tools/env/release.sh"
    }
}
